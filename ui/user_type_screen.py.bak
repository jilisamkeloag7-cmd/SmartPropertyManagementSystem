
import os
import sys

from PySide6.QtWidgets import (QWidget, QVBoxLayout, QHBoxLayout,
                                QLabel, QPushButton, QFrame, QGridLayout,
                                QScrollArea)
from PySide6.QtCore import Qt
from PySide6.QtGui import QPixmap, QPainter, QColor, QLinearGradient, QBrush
from ui import theme


ROLE_CARD_W = 220
ROLE_CARD_H = 160
ROLE_GAP = 20


def _assets_dir() -> str:
    if getattr(sys, "frozen", False):
        exe_dir = os.path.dirname(sys.executable)
        internal = os.path.join(exe_dir, "_internal")
        base = internal if os.path.isdir(internal) else exe_dir
    else:
        base = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    return os.path.join(base, "Assets")


ROLE_BG = os.path.join(_assets_dir(), "login_background.jpg")


class UserTypeScreen(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.parent_window = parent
        self._bg_pixmap = None
        self._load_bg()
        self._build()

    def _load_bg(self):
        if os.path.isfile(ROLE_BG):
            pix = QPixmap(ROLE_BG)
            if not pix.isNull():
                self._bg_pixmap = pix

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.SmoothPixmapTransform, True)

        if self._bg_pixmap is not None:
            # Blur via smooth downscale-upscale trick
            small = self._bg_pixmap.scaled(
                self.width() // 20 or 1, self.height() // 20 or 1,
                Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation,
            )
            blurred = small.scaled(
                self.size(), Qt.KeepAspectRatioByExpanding,
                Qt.SmoothTransformation,
            )
            x = (blurred.width() - self.width()) // 2
            y = (blurred.height() - self.height()) // 2
            painter.drawPixmap(-x, -y, blurred)

            # Heavy overlay — makes cards readable
            if theme.MODE == "dark":
                overlay = QColor(23, 11, 41, 210)
            else:
                overlay = QColor(250, 245, 255, 225)
            painter.fillRect(self.rect(), overlay)
        else:
            # Fallback gradient
            grad = QLinearGradient(0, 0, 0, 1)
            grad.setCoordinateMode(QLinearGradient.ObjectBoundingMode)
            grad.setColorAt(0.0, QColor(theme.BG_GRADIENT_TOP))
            grad.setColorAt(1.0, QColor(theme.BG_GRADIENT_BOTTOM))
            painter.fillRect(self.rect(), QBrush(grad))

        painter.end()

    def _build(self):
        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.setSpacing(0)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.NoFrame)
        scroll.setStyleSheet("QScrollArea { background: transparent; }")
        outer.addWidget(scroll)

        content = QWidget()
        content.setStyleSheet("background: transparent;")
        scroll.setWidget(content)

        layout = QVBoxLayout(content)
        layout.setContentsMargins(40, 40, 40, 40)
        layout.setAlignment(Qt.AlignCenter)
        layout.setSpacing(0)

        title = QLabel("Who are you?")
        title.setAlignment(Qt.AlignCenter)
        title.setStyleSheet(
            f"font-size: {theme.FS_3XL}px; font-weight: 800; "
            f"color: {theme.TEXT_MAIN};"
        )
        layout.addWidget(title)

        layout.addSpacing(theme.SP_2)

        subtitle = QLabel("Select your role to continue")
        subtitle.setAlignment(Qt.AlignCenter)
        subtitle.setStyleSheet(
            f"font-size: {theme.FS_LG}px; color: {theme.TEXT_MUTED};"
        )
        layout.addWidget(subtitle)

        layout.addSpacing(theme.SP_10)

        cards_container = QWidget()
        cards_container.setStyleSheet("background: transparent;")
        cards_outer = QHBoxLayout(cards_container)
        cards_outer.setContentsMargins(0, 0, 0, 0)
        cards_outer.addStretch(1)

        grid = QGridLayout()
        grid.setSpacing(ROLE_GAP)
        grid.setContentsMargins(0, 0, 0, 0)

        roles = [
            ("👑", "Administrator",     theme.PRIMARY),
            ("📋", "Property Manager",  theme.ACCENT_PURPLE),
            ("🏠", "Owner",             theme.SUCCESS),
            ("👤", "Tenant / User",     theme.ACCENT_CYAN),
        ]

        for i, (icon, role, accent) in enumerate(roles):
            card = self._build_role_card(icon, role, accent)
            grid.addWidget(card, i // 2, i % 2)

        cards_outer.addLayout(grid)
        cards_outer.addStretch(1)
        layout.addWidget(cards_container)

        layout.addSpacing(theme.SP_10)

        back_row = QHBoxLayout()
        back_row.addStretch()

        btn_back = QPushButton("← Back to Welcome")
        btn_back.setCursor(Qt.PointingHandCursor)
        btn_back.setFixedHeight(38)
        btn_back.setStyleSheet(f"""
            QPushButton {{
                background: transparent;
                color: {theme.TEXT_MUTED};
                border: none;
                font-size: {theme.FS_BASE}px;
                padding: 6px 14px;
            }}
            QPushButton:hover {{
                color: {theme.PRIMARY};
            }}
        """)
        btn_back.clicked.connect(self._go_back)
        back_row.addWidget(btn_back)
        back_row.addStretch()

        layout.addLayout(back_row)

    def _build_role_card(self, icon, role, accent_color):
        card = QPushButton()
        card.setFixedSize(ROLE_CARD_W, ROLE_CARD_H)
        card.setCursor(Qt.PointingHandCursor)
        card.setText(f"{icon}\n{role}")
        card.setStyleSheet(f"""
            QPushButton {{
                background-color: {theme.BG_CARD};
                border: 2px solid {theme.BORDER};
                border-radius: {theme.RADIUS_LG}px;
                font-size: {theme.FS_MD}px;
                font-weight: bold;
                color: {theme.TEXT_MAIN};
                padding: 20px 10px;
                text-align: center;
            }}
            QPushButton:hover {{
                background-color: {theme.PRIMARY_SOFT};
                border-color: {accent_color};
                color: {accent_color};
            }}
        """)
        card.clicked.connect(lambda checked, r=role: self._on_role_selected(r))
        return card

    def _on_role_selected(self, role):
        self.parent_window.show_login(role)

    def _go_back(self):
        self.parent_window._set_screen("welcome")
